                  ? "hover:bg-neutral-200 text-neutral-600"
                  : "hover:bg-white/10 text-neutral-400"
              }`}
              title={`Lompat ke Babak ${num}`}
            >
              0{num}
            </button>
          );
        })}
      </nav>
    </header>
  );
}
