<file path="app/components/ThreeCookingSkillet3D.tsx">
"use client";

import React, { useEffect, useRef } from "react";
import * as THREE from "three";
import { playSizzlingSFX, playPopSFX } from "../utils/sfx";

interface ThreeCookingSkillet3DProps {
  isCooking: boolean;
  ingredients: string[];
  onCookClick?: () => void;
}

export default function ThreeCookingSkillet3D({
  isCooking,
  ingredients,
  onCookClick,
}: ThreeCookingSkillet3DProps) {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const stateRef = useRef({
    isCooking,
    ingredientsCount: ingredients.length,
    hovered: false,
  });

  useEffect(() => {
    stateRef.current.isCooking = isCooking;
    stateRef.current.ingredientsCount = ingredients.length;
  }, [isCooking, ingredients]);

  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const width = container.clientWidth || 340;
    const height = container.clientHeight || 280;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 100);
    camera.position.set(0, 4.2, 6.2);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(renderer.domElement);

    // 2. Lighting Setup
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
    scene.add(ambientLight);

    const warmKeyLight = new THREE.DirectionalLight(0xffe8b0, 3.0);
    warmKeyLight.position.set(4, 8, 4);
    scene.add(warmKeyLight);

    const cyanFillLight = new THREE.PointLight(0x00f5d4, 2.0, 15);
    cyanFillLight.position.set(-5, 2, -2);
    scene.add(cyanFillLight);

    const stoveFlameLight = new THREE.PointLight(0xff4500, 3.5, 12);
    stoveFlameLight.position.set(0, -1.8, 0);
    scene.add(stoveFlameLight);

    // 3. Pan Geometry Assembly
    const panGroup = new THREE.Group();
    scene.add(panGroup);

    // Cast Iron Skillet Body
    const skilletMat = new THREE.MeshStandardMaterial({
      color: 0x1c1e24,
      metalness: 0.85,
      roughness: 0.28,
      flatShading: false,
    });

    // Outer Pan
    const panBodyGeom = new THREE.CylinderGeometry(2.2, 1.8, 0.6, 40, 1, false);
    const panBody = new THREE.Mesh(panBodyGeom, skilletMat);
    panGroup.add(panBody);

    // Top Rim
    const rimGeom = new THREE.TorusGeometry(2.2, 0.08, 16, 50);
    const rim = new THREE.Mesh(rimGeom, skilletMat);
    rim.rotation.x = Math.PI / 2;
    rim.position.y = 0.3;
    panGroup.add(rim);

    // Long Cast-Iron Handle
    const handleGeom = new THREE.CylinderGeometry(0.12, 0.16, 2.8, 16);
    const handle = new THREE.Mesh(handleGeom, skilletMat);
    handle.rotation.z = Math.PI / 2;
    handle.position.set(3.4, 0.2, 0);
    panGroup.add(handle);

    // Golden Shimmering Olive Oil Surface
    const oilGeom = new THREE.CylinderGeometry(2.05, 2.05, 0.05, 36);
    const oilMat = new THREE.MeshStandardMaterial({
      color: 0xeab308,
      roughness: 0.1,
      metalness: 0.2,
      transparent: true,
      opacity: 0.85,
      emissive: 0x854d0e,
      emissiveIntensity: 0.5,
    });
    const oilSurface = new THREE.Mesh(oilGeom, oilMat);
    oilSurface.position.y = 0.18;
    panGroup.add(oilSurface);

    // 4. 3D Garlic Cloves (Sliced pieces)
    const garlicGroup = new THREE.Group();
    const garlicGeom = new THREE.CylinderGeometry(0.18, 0.2, 0.06, 8);
    const garlicMat = new THREE.MeshStandardMaterial({
      color: 0xfef9c3,
      roughness: 0.35,
      metalness: 0.05,
    });
    for (let i = 0; i < 9; i++) {
      const g = new THREE.Mesh(garlicGeom, garlicMat);
      const angle = (i / 9) * Math.PI * 2 + Math.random() * 0.4;
      const radius = 0.5 + Math.random() * 1.1;
      g.position.set(Math.cos(angle) * radius, 0.23, Math.sin(angle) * radius);
      g.rotation.set(Math.random() * 0.2, Math.random() * Math.PI, Math.random() * 0.2);
      garlicGroup.add(g);
    }
    panGroup.add(garlicGroup);

    // 5. 3D Red Chili Flakes
    const chiliGroup = new THREE.Group();
    const chiliGeom = new THREE.TetrahedronGeometry(0.1, 0);
    const chiliMat = new THREE.MeshStandardMaterial({
      color: 0xdc2626,
      emissive: 0x991b1b,
      emissiveIntensity: 0.4,
      roughness: 0.3,
    });
    for (let i = 0; i < 16; i++) {
      const c = new THREE.Mesh(chiliGeom, chiliMat);
      const angle = (i / 16) * Math.PI * 2 + Math.random() * 0.5;
      const radius = 0.3 + Math.random() * 1.4;
      c.position.set(Math.cos(angle) * radius, 0.24, Math.sin(angle) * radius);
      c.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      chiliGroup.add(c);
    }
    panGroup.add(chiliGroup);

    // 6. Sizzling Steam / Smoke Points
    const steamCount = 30;
    const steamGeom = new THREE.BufferGeometry();
    const steamPos = new Float32Array(steamCount * 3);
    const steamSpeeds = new Float32Array(steamCount);

    for (let i = 0; i < steamCount; i++) {
      const i3 = i * 3;
      steamPos[i3] = (Math.random() - 0.5) * 2.5;
      steamPos[i3 + 1] = 0.25 + Math.random() * 2.5;
      steamPos[i3 + 2] = (Math.random() - 0.5) * 2.5;
      steamSpeeds[i] = Math.random() * 0.04 + 0.02;
    }
    steamGeom.setAttribute("position", new THREE.BufferAttribute(steamPos, 3));
    const steamMat = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.25,
      transparent: true,
      opacity: 0.4,
      blending: THREE.AdditiveBlending,
    });
    const steamPoints = new THREE.Points(steamGeom, steamMat);
    panGroup.add(steamPoints);

    // 7. Mouse Tilt Interaction
    let targetTiltX = 0;
    let targetTiltY = 0;
    let tiltX = 0;
    let tiltY = 0;

    const handlePointerMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      targetTiltY = ((e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2)) * 0.35;
      targetTiltX = ((e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2)) * 0.25;
    };

    const handlePointerEnter = () => {
      stateRef.current.hovered = true;
    };

    const handlePointerLeave = () => {
      stateRef.current.hovered = false;
      targetTiltX = 0;
      targetTiltY = 0;
    };

    container.addEventListener("mousemove", handlePointerMove);
    container.addEventListener("mouseenter", handlePointerEnter);
    container.addEventListener("mouseleave", handlePointerLeave);

    // 8. Render Animation Loop
    let animId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();
      const { isCooking, ingredientsCount } = stateRef.current;

      // Tilt lerp
      tiltX += (targetTiltX - tiltX) * 0.08;
      tiltY += (targetTiltY - tiltY) * 0.08;

      // Sizzle vibration if cooking
      const sizzleShake = isCooking ? Math.sin(elapsed * 55) * 0.03 : 0;
      panGroup.position.y = sizzleShake + Math.sin(elapsed * 1.5) * 0.04;
      panGroup.rotation.x = 0.35 + tiltX + (isCooking ? Math.cos(elapsed * 40) * 0.02 : 0);
      panGroup.rotation.y = -0.3 + tiltY + elapsed * 0.2;
      panGroup.rotation.z = isCooking ? Math.sin(elapsed * 50) * 0.02 : 0;

      // Oil Surface Shimmer
      const oilScale = 1 + Math.sin(elapsed * 6) * 0.015;
      oilSurface.scale.set(oilScale, 1, oilScale);
      oilMat.emissiveIntensity = isCooking ? 0.8 + Math.sin(elapsed * 8) * 0.3 : 0.4;

      // Stove flame light modulation
      stoveFlameLight.intensity = isCooking ? 5.5 + Math.sin(elapsed * 25) * 2.0 : 1.5;

      // Steam animation
      const pos = steamGeom.attributes.position.array as Float32Array;
      for (let i = 0; i < steamCount; i++) {
        const i3 = i * 3;
        pos[i3 + 1] += steamSpeeds[i] * (isCooking ? 2.2 : 0.8);
        pos[i3] += Math.sin(elapsed * 3 + i) * 0.01;
        if (pos[i3 + 1] > 3.2) {
          pos[i3 + 1] = 0.25;
          pos[i3] = (Math.random() - 0.5) * 2.2;
          pos[i3 + 2] = (Math.random() - 0.5) * 2.2;
        }
      }
      steamGeom.attributes.position.needsUpdate = true;
      steamMat.opacity = isCooking ? 0.65 : 0.25;

      // Ingredients visibility based on selection
      garlicGroup.visible = ingredientsCount >= 1;
      chiliGroup.visible = ingredientsCount >= 2;

      renderer.render(scene, camera);
    };

    animate();

    const handleResize = () => {
      if (!container) return;
      const w = container.clientWidth || 340;
      const h = container.clientHeight || 280;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener("resize", handleResize);

    return () => {
      cancelAnimationFrame(animId);
      window.removeEventListener("resize", handleResize);
      container.removeEventListener("mousemove", handlePointerMove);
      container.removeEventListener("mouseenter", handlePointerEnter);
      container.removeEventListener("mouseleave", handlePointerLeave);

      if (container && renderer.domElement) {
        container.removeChild(renderer.domElement);
      }

      panBodyGeom.dispose();
      rimGeom.dispose();
      handleGeom.dispose();
      skilletMat.dispose();
      oilGeom.dispose();
      oilMat.dispose();
      garlicGeom.dispose();
      garlicMat.dispose();
      chiliGeom.dispose();
      chiliMat.dispose();
      steamGeom.dispose();
      steamMat.dispose();
      renderer.dispose();
    };
  }, []);

  return (
    <div
      ref={containerRef}
      onClick={onCookClick}
      data-cursor-portal="Wajan Aglio Olio"
      className="relative w-full h-64 sm:h-72 cursor-pointer flex items-center justify-center select-none"
      title="Wajan 3D Aglio Olio (Sentuh untuk melihat bahan dan menumis)"
    />
  );
}
</file>

<file path="app/components/ThreeHeartConflict3D.tsx">
"use client";

import React, { useEffect, useRef } from "react";
import * as THREE from "three";

interface ThreeHeartConflict3DProps {
  state: "keraguan" | "tekad";
  className?: string;
}

export default function ThreeHeartConflict3D({
  state,
  className = "w-full h-80 sm:h-96",
}: ThreeHeartConflict3DProps) {
  const mountRef = useRef<HTMLDivElement | null>(null);
  const stateRef = useRef(state);
  stateRef.current = state;

  useEffect(() => {
    const container = mountRef.current;
    if (!container) return;

    let animId: number;
    let isMounted = true;

    const width = container.clientWidth || 340;
    const height = container.clientHeight || 340;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.set(0, 0, 6.2);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.4;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(renderer.domElement);

    // 2. Studio Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(4, 5, 4);
    scene.add(keyLight);

    const stateLight = new THREE.PointLight(
      state === "tekad" ? 0xffb703 : 0x7c3aed,
      3.5,
      12
    );
    stateLight.position.set(0, 0, 1.5);
    scene.add(stateLight);

    const rimLight = new THREE.DirectionalLight(
      state === "tekad" ? 0xffd700 : 0xa855f7,
      2.8
    );
    rimLight.position.set(-4, -4, -3);
    scene.add(rimLight);

    // 3. Central Kinetic 3D Group
    const coreGroup = new THREE.Group();
    scene.add(coreGroup);

    // Central Faceted Amethyst / Golden Octahedron Core
    const coreGeometry = new THREE.OctahedronGeometry(1.2, 1);
    const coreMaterial = new THREE.MeshPhysicalMaterial({
      color: state === "tekad" ? 0xf59e0b : 0x4c1d95,
      emissive: state === "tekad" ? 0xd97706 : 0x2e1065,
      emissiveIntensity: state === "tekad" ? 0.6 : 0.25,
      roughness: 0.2,
      metalness: 0.8,
      clearcoat: 0.9,
      clearcoatRoughness: 0.1,
      wireframe: false,
      flatShading: true,
    });
    const coreMesh = new THREE.Mesh(coreGeometry, coreMaterial);
    coreGroup.add(coreMesh);

    // Wireframe Outer Cage
    const wireGeometry = new THREE.OctahedronGeometry(1.28, 1);
    const wireMaterial = new THREE.MeshBasicMaterial({
      color: state === "tekad" ? 0xfef08a : 0xc084fc,
      wireframe: true,
      transparent: true,
      opacity: 0.75,
    });
    const wireMesh = new THREE.Mesh(wireGeometry, wireMaterial);
    coreGroup.add(wireMesh);

    // Gyroscopic Rings (Resolution & Vows)
    const ringMats: THREE.MeshStandardMaterial[] = [];
    const ringMeshes: THREE.Mesh[] = [];

    const ringRadii = [1.7, 2.05, 2.4];
    ringRadii.forEach((rad, idx) => {
      const ringGeo = new THREE.TorusGeometry(rad, 0.04, 16, 100);
      const ringMat = new THREE.MeshStandardMaterial({
        color: state === "tekad" ? 0xffd700 : 0x6b21a8,
        metalness: 0.95,
        roughness: 0.15,
        emissive: state === "tekad" ? 0xf59e0b : 0x3b0764,
        emissiveIntensity: state === "tekad" ? 0.5 : 0.1,
      });
      ringMats.push(ringMat);
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      ringMesh.rotation.x = (idx * Math.PI) / 3;
      ringMesh.rotation.y = (idx * Math.PI) / 4;
      coreGroup.add(ringMesh);
      ringMeshes.push(ringMesh);
    });

    // Surrounding Shard Crystals
    const shardCount = 18;
    const shardGroup = new THREE.Group();
    coreGroup.add(shardGroup);

    const shards: THREE.Mesh[] = [];
    for (let i = 0; i < shardCount; i++) {
      const sGeo = new THREE.TetrahedronGeometry(0.12 + Math.random() * 0.08);
      const sMat = new THREE.MeshStandardMaterial({
        color: state === "tekad" ? 0xfef08a : 0x9333ea,
        metalness: 0.8,
        roughness: 0.2,
      });
      const shard = new THREE.Mesh(sGeo, sMat);
      const theta = (i / shardCount) * Math.PI * 2;
      const phi = (Math.random() - 0.5) * Math.PI;
      const radius = 2.6 + Math.random() * 0.5;
      shard.position.set(
        radius * Math.cos(theta) * Math.cos(phi),
        radius * Math.sin(phi),
        radius * Math.sin(theta) * Math.cos(phi)
      );
      shardGroup.add(shard);
      shards.push(shard);
    }

    // 4. Interactive Mouse Drag / Orbit
    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let targetRotY = 0;
    let targetRotX = 0;

    const onPointerDown = (e: MouseEvent) => {
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
    };

    const onPointerMove = (e: MouseEvent) => {
      if (isDragging) {
        const deltaX = e.clientX - prevMouseX;
        const deltaY = e.clientY - prevMouseY;
        targetRotY += deltaX * 0.015;
        targetRotX += deltaY * 0.015;
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      } else {
        const rect = container.getBoundingClientRect();
        const normX = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
        const normY = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
        targetRotY = normX * 0.5;
        targetRotX = normY * 0.35;
      }
    };

    const onPointerUp = () => {
      isDragging = false;
    };

    container.addEventListener("mousedown", onPointerDown);
    window.addEventListener("mousemove", onPointerMove);
    window.addEventListener("mouseup", onPointerUp);

    // 5. Render Loop
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();
      const currentState = stateRef.current;
      const isTekad = currentState === "tekad";

      // Dynamically morph materials based on state
      const targetCoreColor = isTekad ? new THREE.Color(0xf59e0b) : new THREE.Color(0x4c1d95);
      const targetEmissive = isTekad ? new THREE.Color(0xd97706) : new THREE.Color(0x2e1065);
      const targetWireColor = isTekad ? new THREE.Color(0xfef08a) : new THREE.Color(0xc084fc);

      coreMaterial.color.lerp(targetCoreColor, 0.08);
      coreMaterial.emissive.lerp(targetEmissive, 0.08);
      coreMaterial.emissiveIntensity = THREE.MathUtils.lerp(
        coreMaterial.emissiveIntensity,
        isTekad ? 0.7 : 0.25,
        0.08
      );
      wireMaterial.color.lerp(targetWireColor, 0.08);

      stateLight.color.lerp(isTekad ? new THREE.Color(0xffb703) : new THREE.Color(0x7c3aed), 0.08);
      rimLight.color.lerp(isTekad ? new THREE.Color(0xffd700) : new THREE.Color(0xa855f7), 0.08);

      ringMats.forEach((mat) => {
        mat.color.lerp(isTekad ? new THREE.Color(0xffd700) : new THREE.Color(0x6b21a8), 0.08);
        mat.emissive.lerp(isTekad ? new THREE.Color(0xf59e0b) : new THREE.Color(0x3b0764), 0.08);
        mat.emissiveIntensity = THREE.MathUtils.lerp(mat.emissiveIntensity, isTekad ? 0.6 : 0.1, 0.08);
      });

      // Core rotation: smooth and fast when Tekad, erratic and slow when Keraguan
      const spinSpeed = isTekad ? 1.4 : 0.6;
      coreMesh.rotation.y += 0.015 * spinSpeed;
      coreMesh.rotation.x = Math.sin(elapsed * 0.8) * 0.2;
      wireMesh.rotation.y = -coreMesh.rotation.y;
      wireMesh.rotation.z += 0.008 * spinSpeed;

      // Gyroscopic rings rotation
      ringMeshes.forEach((mesh, idx) => {
        mesh.rotation.x += 0.01 * (idx + 1) * spinSpeed;
        mesh.rotation.y += 0.008 * (3 - idx) * spinSpeed;
      });

      // Shards orbit
      shardGroup.rotation.y -= 0.006 * spinSpeed;
      shardGroup.rotation.z = Math.sin(elapsed * 0.5) * 0.15;

      // Bobbing
      coreGroup.position.y = Math.sin(elapsed * 1.6) * 0.1;

      // Mouse drag lerp
      coreGroup.rotation.y += (targetRotY - coreGroup.rotation.y) * 0.08;
      coreGroup.rotation.x += (targetRotX - coreGroup.rotation.x) * 0.08;

      renderer.render(scene, camera);
    };

    animate();

    const handleResize = () => {
      if (!container) return;
      const w = container.clientWidth || 340;
      const h = container.clientHeight || 340;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener("resize", handleResize);

    return () => {
      isMounted = false;
      cancelAnimationFrame(animId);
      window.removeEventListener("resize", handleResize);
      container.removeEventListener("mousedown", onPointerDown);
      window.removeEventListener("mousemove", onPointerMove);
      window.removeEventListener("mouseup", onPointerUp);

      if (container && renderer.domElement) {
        container.removeChild(renderer.domElement);
      }
      renderer.dispose();
      coreGeometry.dispose();
      coreMaterial.dispose();
      wireGeometry.dispose();
      wireMaterial.dispose();
      ringMats.forEach((m) => m.dispose());
    };
  }, []);

  return (
    <div
      className={`relative rounded-3xl border border-purple-500/30 bg-neutral-950/80 backdrop-blur-xl overflow-hidden shadow-[0_20px_60px_rgba(124,58,237,0.25)] flex flex-col items-center justify-center select-none group ${className}`}
    >
      <div
        ref={mountRef}
        data-cursor-portal="Putar Patung Resonansi 3D"
        className="w-full h-full cursor-grab active:cursor-grabbing flex items-center justify-center"
      />

      {/* Floating 3D Badge */}
      <div className="absolute top-3 left-4 flex items-center gap-2 pointer-events-none">
        <span
          className="w-2.5 h-2.5 rounded-full animate-ping"
          style={{ background: state === "tekad" ? "#FFD700" : "#A855F7" }}
        />
        <span className="text-[10px] font-mono tracking-widest text-slate-200 font-bold uppercase bg-black/80 px-2.5 py-1 rounded-full border border-white/10 backdrop-blur-md">
          {state === "tekad" ? "3D CORE: TEKAD EMAS ROBIT" : "3D CORE: TITIK BEKU KERAGUAN"}
        </span>
      </div>

      <div className="absolute bottom-3 text-center pointer-events-none">
        <span className="text-[10px] font-mono tracking-wider text-slate-400 bg-black/70 px-3 py-1 rounded-full border border-white/10 backdrop-blur-xs">
          Klik & Geser untuk Memutar Patung Dual-Resonansi 3D
        </span>
      </div>
    </div>
  );
}
</file>

<file path="app/components/ThreeMoscowDome3D.tsx">
"use client";

import React, { useEffect, useRef } from "react";
import * as THREE from "three";

export default function ThreeMoscowDome3D() {
  const containerRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const width = container.clientWidth || 320;
    const height = container.clientHeight || 280;

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);
    camera.position.set(0, 1.2, 7.5);
    camera.lookAt(0, 0.4, 0);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.3;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(renderer.domElement);

    // 2. Lighting Setup (Cold Moscow Winter Night)
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const moonLight = new THREE.DirectionalLight(0xbbe1fa, 2.8);
    moonLight.position.set(4, 7, 5);
    scene.add(moonLight);

    const warmLanternFill = new THREE.PointLight(0xf59e0b, 2.5, 15);
    warmLanternFill.position.set(-4, -1, 3);
    scene.add(warmLanternFill);

    const goldSpireLight = new THREE.PointLight(0xffd700, 2.0, 10);
    goldSpireLight.position.set(0, 3.5, 0);
    scene.add(goldSpireLight);

    // 3. St. Basil's 3D Cathedral Onion Dome Model Assembly
    const domeGroup = new THREE.Group();
    scene.add(domeGroup);

    // Base Drum Tower (Brick & Stone Arcade)
    const drumGeom = new THREE.CylinderGeometry(1.4, 1.45, 1.2, 32);
    const drumMat = new THREE.MeshStandardMaterial({
      color: 0x991b1b, // Red brick
      roughness: 0.6,
      metalness: 0.1,
    });
    const drum = new THREE.Mesh(drumGeom, drumMat);
    drum.position.y = -0.8;
    domeGroup.add(drum);

    // Cornice Ring
    const corniceGeom = new THREE.TorusGeometry(1.42, 0.08, 16, 40);
    const corniceMat = new THREE.MeshStandardMaterial({
      color: 0xfef08a,
      roughness: 0.3,
      metalness: 0.4,
    });
    const cornice = new THREE.Mesh(corniceGeom, corniceMat);
    cornice.rotation.x = Math.PI / 2;
    cornice.position.y = -0.2;
    domeGroup.add(cornice);

    // Iconic Russian Onion Dome Profile using LatheGeometry
    const onionPoints: THREE.Vector2[] = [];
    const segments = 24;
    for (let i = 0; i <= segments; i++) {
      const t = i / segments;
      // Formula for classic bulbous onion dome curve
      let r = 0;
      let y = t * 2.4;
      if (t < 0.35) {
        // Bulbous expansion
        r = 1.35 * Math.sin((t / 0.35) * (Math.PI / 2));
      } else {
        // Tapering graceful point
        const pt = (t - 0.35) / 0.65;
        r = 1.35 * Math.cos(pt * (Math.PI / 2)) * Math.pow(1 - pt, 0.4);
      }
      onionPoints.push(new THREE.Vector2(Math.max(0.02, r), y));
    }

    const onionGeom = new THREE.LatheGeometry(onionPoints, 36);
    const onionMat = new THREE.MeshStandardMaterial({
      color: 0x1d4ed8, // Imperial Russian Blue
      roughness: 0.22,
      metalness: 0.75,
      emissive: 0x0f172a,
      emissiveIntensity: 0.3,
    });
    const onionMesh = new THREE.Mesh(onionGeom, onionMat);
    onionMesh.position.y = -0.2;
    domeGroup.add(onionMesh);

    // Golden Chevron Spiral Ribs
    const spiralRibGroup = new THREE.Group();
    const ribGeom = new THREE.TorusGeometry(1.36, 0.05, 12, 36);
    const goldRibMat = new THREE.MeshStandardMaterial({
      color: 0xffd700,
      metalness: 0.9,
      roughness: 0.15,
      emissive: 0xb45309,
      emissiveIntensity: 0.4,
    });

    for (let i = 0; i < 4; i++) {
      const rib = new THREE.Mesh(ribGeom, goldRibMat);
      rib.rotation.x = Math.PI / 2.6;
      rib.rotation.z = (i * Math.PI) / 2;
      rib.position.y = 0.5;
      spiralRibGroup.add(rib);
    }
    domeGroup.add(spiralRibGroup);

    // Golden Spire & Cross
    const spireGeom = new THREE.CylinderGeometry(0.04, 0.1, 1.2, 16);
    const spireMat = new THREE.MeshStandardMaterial({
      color: 0xffd700,
      metalness: 0.92,
      roughness: 0.12,
    });
    const spire = new THREE.Mesh(spireGeom, spireMat);
    spire.position.y = 2.8;
    domeGroup.add(spire);

    // Cross Horizontal Arm
    const crossArmGeom = new THREE.CylinderGeometry(0.03, 0.03, 0.5, 12);
    crossArmGeom.rotateZ(Math.PI / 2);
    const crossArm = new THREE.Mesh(crossArmGeom, spireMat);
    crossArm.position.y = 3.1;
    domeGroup.add(crossArm);

    // 4. Local Swirling Russian Snowflakes
    const snowCount = 45;
    const snowGeom = new THREE.BufferGeometry();
    const snowPositions = new Float32Array(snowCount * 3);
    const snowSpeeds = new Float32Array(snowCount);

    for (let i = 0; i < snowCount; i++) {
      const i3 = i * 3;
      snowPositions[i3] = (Math.random() - 0.5) * 5;
      snowPositions[i3 + 1] = Math.random() * 6 - 2;
      snowPositions[i3 + 2] = (Math.random() - 0.5) * 4;
      snowSpeeds[i] = Math.random() * 0.025 + 0.015;
    }
    snowGeom.setAttribute("position", new THREE.BufferAttribute(snowPositions, 3));
    const snowMat = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.12,
      transparent: true,
      opacity: 0.85,
    });
    const snowPoints = new THREE.Points(snowGeom, snowMat);
    scene.add(snowPoints);

    // 5. Mouse Parallax
    let targetMouseX = 0;
    let targetMouseY = 0;
    let mouseX = 0;
    let mouseY = 0;

    const handlePointerMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      targetMouseX = ((e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2)) * 0.6;
      targetMouseY = -((e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2)) * 0.4;
    };

    const handlePointerLeave = () => {
      targetMouseX = 0;
      targetMouseY = 0;
    };

    container.addEventListener("mousemove", handlePointerMove);
    container.addEventListener("mouseleave", handlePointerLeave);

    // 6. Animation Loop
    let animId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();

      mouseX += (targetMouseX - mouseX) * 0.08;
      mouseY += (targetMouseY - mouseY) * 0.08;

      domeGroup.rotation.y = elapsed * 0.35 + mouseX;
      domeGroup.rotation.x = mouseY * 0.4 + Math.sin(elapsed * 0.6) * 0.03;

      // Animate Snow
      const pos = snowGeom.attributes.position.array as Float32Array;
      for (let i = 0; i < snowCount; i++) {
        const i3 = i * 3;
        pos[i3 + 1] -= snowSpeeds[i];
        pos[i3] -= 0.008; // Diagonal wind
        if (pos[i3 + 1] < -2.2) {
          pos[i3 + 1] = 4.2;
          pos[i3] = (Math.random() - 0.5) * 5;
        }
      }
      snowGeom.attributes.position.needsUpdate = true;

      renderer.render(scene, camera);
    };

    animate();

    const handleResize = () => {
      if (!container) return;
      const w = container.clientWidth || 320;
      const h = container.clientHeight || 280;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener("resize", handleResize);

    return () => {
      cancelAnimationFrame(animId);
      window.removeEventListener("resize", handleResize);
      container.removeEventListener("mousemove", handlePointerMove);
      container.removeEventListener("mouseleave", handlePointerLeave);

      if (container && renderer.domElement) {
        container.removeChild(renderer.domElement);
      }

      drumGeom.dispose();
      drumMat.dispose();
      corniceGeom.dispose();
      corniceMat.dispose();
      onionGeom.dispose();
      onionMat.dispose();
      ribGeom.dispose();
      goldRibMat.dispose();
      spireGeom.dispose();
      spireMat.dispose();
      crossArmGeom.dispose();
      snowGeom.dispose();
      snowMat.dispose();
      renderer.dispose();
    };
  }, []);

  return (
    <div
      ref={containerRef}
      data-cursor-portal="Kubah Moscow 3D"
      className="relative w-full h-64 sm:h-72 cursor-pointer flex items-center justify-center select-none"
      title="Kubah Katedral Moscow 3D (Sentuh untuk memutar)"
    />
  );
}
